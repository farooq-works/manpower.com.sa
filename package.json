{
  "name": "manpower-cms",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "prepare:assets": "node server/scripts/prepare-assets.js",
    "dev": "npm run prepare:assets && concurrently -k -n api,client \"npm:dev --workspace=@manpower/server\" \"npm:start --workspace=@manpower/client\"",
    "build": "npm run prepare:assets && npm run build --workspace=@manpower/client",
    "test": "npm run test --workspace=@manpower/server && npm run test --workspace=@manpower/client -- --watch=false",
    "migrate:static": "npm run migrate:static --workspace=@manpower/server --",
    "create-admin": "npm run create-admin --workspace=@manpower/server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0"
  }
}
